index=lab_beacon sourcetype="soc:network:http" | sort 0 mode _time | streamstats current=f last(_time) as previous by mode | eval interval_seconds=_time-previous | where isnotnull(previous) | eventstats median(interval_seconds) as profile_median by mode | eval absolute_deviation=abs(interval_seconds-profile_median) | stats count(interval_seconds) as intervals avg(interval_seconds) as mean_seconds stdev(interval_seconds) as stdev_seconds median(interval_seconds) as median_seconds median(absolute_deviation) as mad_seconds min(interval_seconds) as min_seconds max(interval_seconds) as max_seconds by mode | eval CV=round(stdev_seconds/mean_seconds,3), relative_MAD=round(mad_seconds/median_seconds,3), mean_seconds=round(mean_seconds,3), median_seconds=round(median_seconds,3) | where intervals>=9 AND relative_MAD<0.20 | table mode intervals median_seconds mad_seconds CV relative_MAD

<dashboard version="1.1" theme="dark">
  <label>Network Beaconing Investigation</label>
  <description>MOHAMEDAHMED | UTC</description>
  <row>
    <panel>
      <title>Captured HTTP requests</title>
      <single>
        <search>
          <query>index=lab_beacon sourcetype="soc:network:http" | stats count</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">0</option>
        <option name="showTrendIndicator">0</option>
        <option name="useColors">1</option>
        <option name="colorMode">none</option>
        <option name="rangeColors">["0x53a051"]</option>
        <option name="rangeValues">[]</option>
      </single>
    </panel>
    <panel>
      <title>Endpoint process launches</title>
      <single>
        <search>
          <query>index=lab_beacon provider="Microsoft-Windows-Sysmon" event_id=1 | stats count</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">0</option>
        <option name="showTrendIndicator">0</option>
        <option name="useColors">1</option>
        <option name="colorMode">none</option>
        <option name="rangeColors">["0x53a051"]</option>
        <option name="rangeValues">[]</option>
      </single>
    </panel>
    <panel>
      <title>Sysmon network events</title>
      <single>
        <search>
          <query>index=lab_beacon provider="Microsoft-Windows-Sysmon" event_id=3 | stats count</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="numberPrecision">0</option>
        <option name="showSparkline">0</option>
        <option name="showTrendIndicator">0</option>
        <option name="useColors">1</option>
        <option name="colorMode">none</option>
        <option name="rangeColors">["0x53a051"]</option>
        <option name="rangeValues">[]</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Request timing by traffic profile</title>
      <table>
        <search>
          <query>index=lab_beacon sourcetype="soc:network:http" | sort 0 mode _time | streamstats current=f last(_time) as previous by mode | eval interval_seconds=_time-previous | where isnotnull(previous) | eventstats median(interval_seconds) as profile_median by mode | eval absolute_deviation=abs(interval_seconds-profile_median) | stats count(interval_seconds) as intervals avg(interval_seconds) as mean_seconds stdev(interval_seconds) as stdev_seconds median(interval_seconds) as median_seconds median(absolute_deviation) as mad_seconds min(interval_seconds) as min_seconds max(interval_seconds) as max_seconds by mode | eval CV=round(stdev_seconds/mean_seconds,3), relative_MAD=round(mad_seconds/median_seconds,3), mean_seconds=round(mean_seconds,3), median_seconds=round(median_seconds,3) | table mode intervals mean_seconds median_seconds min_seconds max_seconds CV relative_MAD</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="count">12</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Captured request timeline</title>
      <table>
        <search>
          <query>index=lab_beacon sourcetype="soc:network:http" | sort 0 _time | eval UTC=substr(utc,12,12) | table UTC mode sequence src_port pid path</query>
          <earliest>0</earliest>
          <latest>now</latest>
        </search>
        <option name="count">12</option>
        <option name="drilldown">none</option>
        <option name="rowNumbers">false</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</dashboard>
